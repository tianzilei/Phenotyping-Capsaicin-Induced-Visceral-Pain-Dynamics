{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "termination_events",
  "description": "字段语义契约；CSV 的跨行约束见 docs/data_contracts.md",
  "type": "object",
  "required": [
    "subject_id",
    "event_type",
    "event_time_min",
    "last_observed_min",
    "source_reference",
    "verified"
  ],
  "properties": {
    "subject_id": {
      "description": "研究编号",
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "description": "E/T/completed/unknown",
      "type": "string",
      "enum": [
        "E",
        "T",
        "completed",
        "unknown"
      ]
    },
    "event_time_min": {
      "description": "真实结束时间；不能直接用 E/T 首次标记列推断",
      "type": [
        "number",
        "null"
      ]
    },
    "last_observed_min": {
      "description": "最后有效评分时刻",
      "type": [
        "number",
        "null"
      ]
    },
    "source_reference": {
      "description": "原始记录定位",
      "type": "string"
    },
    "verified": {
      "description": "已核验标记含义与事件时间",
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
