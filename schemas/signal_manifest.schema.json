{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "signal_manifest",
  "description": "字段语义契约；CSV 的跨行约束见 docs/data_contracts.md",
  "type": "object",
  "required": [
    "subject_id",
    "recording_id",
    "modality",
    "path",
    "format",
    "sampling_rate_hz",
    "unit",
    "start_relative_s",
    "duration_s",
    "sha256",
    "verified"
  ],
  "properties": {
    "subject_id": {
      "description": "研究编号",
      "type": "string",
      "minLength": 1
    },
    "recording_id": {
      "description": "唯一记录编号",
      "type": "string"
    },
    "modality": {
      "description": "ECG/EGG/fNIRS",
      "type": "string",
      "enum": [
        "ECG",
        "EGG",
        "fNIRS"
      ]
    },
    "path": {
      "description": "本地信号路径",
      "type": "string"
    },
    "format": {
      "description": "文件格式",
      "type": "string"
    },
    "sampling_rate_hz": {
      "description": "核验后的采样率",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "unit": {
      "description": "原始量纲",
      "type": "string"
    },
    "start_relative_s": {
      "description": "相对给药起点",
      "type": "number"
    },
    "duration_s": {
      "description": "记录长度",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sha256": {
      "description": "文件摘要",
      "type": "string"
    },
    "verified": {
      "description": "映射和时间已核验",
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
