{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "subjects",
  "description": "字段语义契约；CSV 的跨行约束见 docs/data_contracts.md",
  "type": "object",
  "required": [
    "subject_id",
    "included",
    "exclusion_reason",
    "cohort"
  ],
  "properties": {
    "subject_id": {
      "description": "去标识化研究编号；唯一",
      "type": "string",
      "minLength": 1
    },
    "included": {
      "description": "是否纳入；依据审计后的样本清单",
      "type": "boolean"
    },
    "exclusion_reason": {
      "description": "排除原因，可空",
      "type": "string"
    },
    "cohort": {
      "description": "来源/队列；定义待核验",
      "type": "string"
    }
  },
  "additionalProperties": false
}
