{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "physiology_windows",
  "description": "字段语义契约；CSV 的跨行约束见 docs/data_contracts.md",
  "type": "object",
  "required": [
    "subject_id",
    "recording_id",
    "modality",
    "roi",
    "window_start_min",
    "window_end_min",
    "feature",
    "value",
    "unit",
    "valid_fraction",
    "qc_pass",
    "available_at_min"
  ],
  "properties": {
    "subject_id": {
      "description": "研究编号",
      "type": "string",
      "minLength": 1
    },
    "recording_id": {
      "description": "记录编号",
      "type": "string"
    },
    "modality": {
      "description": "ECG/EGG/fNIRS",
      "type": "string",
      "enum": [
        "ECG",
        "EGG",
        "fNIRS"
      ]
    },
    "roi": {
      "description": "区域，无则空",
      "type": "string"
    },
    "window_start_min": {
      "description": "窗口起点",
      "type": "number"
    },
    "window_end_min": {
      "description": "窗口终点",
      "type": "number"
    },
    "feature": {
      "description": "特征名",
      "type": "string"
    },
    "value": {
      "description": "特征值",
      "type": [
        "number",
        "null"
      ]
    },
    "unit": {
      "description": "单位",
      "type": "string"
    },
    "valid_fraction": {
      "description": "有效比例",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "qc_pass": {
      "description": "按冻结规则判断",
      "type": "boolean"
    },
    "available_at_min": {
      "description": "用于预测时最早可获得时刻",
      "type": "number"
    }
  },
  "additionalProperties": false
}
