  "gates": {"exploratory_attenuation_db": 6.0, "legacy_attenuation_db": 15.0, "slow_band_hz": [0.033, 0.067], "null_leakage_db_max": -60.0, "slow_injection_rmse_fraction_max": 0.03, "slow_injection_phase_rad_max": 0.05},
  "hrv": {"min_valid_nn_fraction": 0.85, "sampen_min_contiguous_seconds": 120},
